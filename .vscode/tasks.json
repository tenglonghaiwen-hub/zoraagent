{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动后端服务器",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/node-v24.21.0-win-x64/node.exe",
      "args": ["apps/server/server.mjs"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PORT": "4317",
          "ZORA_AGENT_BACKEND": "app-server",
          "ZORA_AGENT_ENABLED": "true"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Zora.*listening|Server.*started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "启动桌面客户端",
      "type": "shell",
      "command": "${workspaceFolder}/start-zora-desktop.cmd",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "运行所有测试",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/node-v24.21.0-win-x64/node.exe",
      "args": ["--test", "tests/*.test.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "检查代码语法",
      "type": "shell",
      "command": "${workspaceFolder}/runtime/node-v24.21.0-win-x64/node.exe",
      "args": ["--check", "apps/server/server.mjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "停止所有 Node 进程",
      "type": "shell",
      "command": "taskkill /F /IM node.exe /T",
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
