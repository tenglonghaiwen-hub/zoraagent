{
  "name": "zora-agent",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node apps/server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/acceptance-desktop.mjs",
    "check": "node --check apps/server/server.mjs && node --check apps/client/app.js",
    "desktop": "npm --prefix apps/desktop start",
    "desktop:install": "npm --prefix apps/desktop install",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "desktop:package": "node scripts/package-desktop.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "docx": "9.7.1",
    "electron-updater": "6.6.2",
    "exceljs": "4.4.0",
    "express-rate-limit": "^7.5.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "1.17.1",
    "pptxgenjs": "4.0.1",
    "sql.js": "^1.14.2"
  },
  "description": "造境 Zora：以包内开源 Codex app-server 为内核的 Windows 创作客户端，连接会话、媒体生成、工作区文件与本地工具（开发版本）。"
}
